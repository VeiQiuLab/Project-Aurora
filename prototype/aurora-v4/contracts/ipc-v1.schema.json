    "persona_ms": {"type": ["number", "null"], "minimum": 0},
    "knowledge_ms": {"type": ["number", "null"], "minimum": 0},
    "rag_ms": {"type": ["number", "null"], "minimum": 0},
    "prompt_assembly_ms": {"type": ["number", "null"], "minimum": 0},
    "history_message_count": {"type": ["number", "null"], "minimum": 0},
    "memory_item_count": {"type": ["number", "null"], "minimum": 0},
    "knowledge_item_count": {"type": ["number", "null"], "minimum": 0},
    "rag_result_count": {"type": ["number", "null"], "minimum": 0},
    "memory_enabled": {"type": "boolean"},
    "persona_enabled": {"type": "boolean"},
    "knowledge_enabled": {"type": "boolean"},
    "rag_enabled": {"type": "boolean"},
    "context_error_stage": {"type": ["string", "null"], "enum": [null, "memory", "persona", "knowledge", "rag", "prompt_assembly"]}
  }
},
    "productionDiagnostics": {
      "type": "object",
      "required": ["backend_mode", "backend_ready", "settings_status", "ollama_think_mode", "think_payload_value", "ollama_keep_alive", "ollama"],
      "additionalProperties": false,
      "properties": {
        "backend_mode": {"const": "production"},
        "local_model": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "backend", "state", "configured_model", "reachable", "model_available", "error_code", "probe_duration_ms"],
          "properties": {
            "provider": {"const": "builtin_local"}, "backend": {"const": "vulkan"},
            "state": {"enum": ["STOPPED", "STARTING", "LOADING_MODEL", "READY", "DEGRADED", "FAILED", "STOPPING"]},
            "configured_model": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,200}$"},
            "reachable": {"type": "boolean"}, "model_available": {"type": "boolean"},
            "error_code": {"enum": ["", "LOCAL_MODEL_UNAVAILABLE"]},
            "probe_duration_ms": {"type": "number", "minimum": 0}
          }
        },
        "backend_ready": {"const": true},
        "settings_status": {"enum": ["loaded", "missing_defaults", "invalid_defaults"]},
        "ollama_think_mode": {"enum": ["on", "off", "default"]},
        "think_payload_value": {"type": ["boolean", "null"]},
        "ollama_keep_alive": {"type": ["string", "null"], "maxLength": 128},
        "ollama": {
          "type": "object",
          "required": ["reachable", "host", "configured_model", "model_available", "error_code", "probe_duration_ms"],
          "additionalProperties": false,
          "properties": {
            "reachable": {"type": "boolean"},
            "host": {"type": "string", "maxLength": 512, "pattern": "^(https?://[^/@?#]+)?$"},
            "configured_model": {"type": "string", "maxLength": 200, "pattern": "^[\\w./:@+-]*$"},
            "model_available": {"type": "boolean"},
            "error_code": {"enum": ["", "MODEL_NOT_CONFIGURED", "MODEL_UNAVAILABLE", "INVALID_HOST", "INVALID_OLLAMA_RESPONSE", "OLLAMA_UNAVAILABLE"]},
            "probe_duration_ms": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "baseEnvelope": {
      "type": "object",
      "required": ["protocol", "version", "type", "payload"],
      "properties": {
        "protocol": {"const": "aurora-ipc"},
        "version": {"const": 1},
        "type": {"type": "string"},
        "request_id": {"$ref": "#/$defs/opaqueId"},
        "session_id": {"$ref": "#/$defs/opaqueId"},
        "generation_id": {"$ref": "#/$defs/opaqueId"},
        "seq": {"type": "integer", "minimum": 0},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "noRequestContext": {
      "not": {
        "anyOf": [
          {"required": ["session_id"]},
          {"required": ["generation_id"]},
          {"required": ["seq"]}
        ]
      }
    },
    "noSequence": {
      "not": {"required": ["seq"]}
    },
    "noIdentifiers": {
      "not": {
        "anyOf": [
          {"required": ["request_id"]},
          {"required": ["session_id"]},
          {"required": ["generation_id"]},
          {"required": ["seq"]}
        ]
      }
    },
    "sidecarState": {
      "enum": [
        "STOPPED",
        "STARTING",
        "HANDSHAKING",
        "READY",
        "DEGRADED",
        "DISCONNECTED",
        "RESTARTING",
        "STOPPING"
      ]
    },
    "terminalState": {
      "enum": ["completed", "cancelled", "failed", "backend_lost", "rejected"]
    },
    "errorCode": {
      "enum": [
        "PROTOCOL_ERROR",
        "PROTOCOL_VERSION_MISMATCH",
        "AUTHENTICATION_FAILED",
        "INVALID_REQUEST",
        "PAYLOAD_TOO_LARGE",
        "BACKEND_NOT_READY",
        "BACKEND_LOST",
        "PROVIDER_UNAVAILABLE",
        "MODEL_UNAVAILABLE",
        "REQUEST_TIMEOUT",
        "REQUEST_CANCELLED",
        "INTERNAL_ERROR",
        "NOT_FOUND",
        "INVALID_CONVERSATION",
        "PERSISTENCE_FAILED",
        "INVALID_SETTING", "INVALID_VALUE", "READ_ONLY", "RESTART_REQUIRED", "PERSISTENCE_ERROR", "CONFLICT"
      ]
    },
    "errorDetail": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"$ref": "#/$defs/errorCode"},
        "message": {"type": "string", "minLength": 1, "maxLength": 512},
        "retryable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "voiceCapabilities": {
      "type": "object",
      "required": [
        "ipc",
        "edge_tts",
        "cosyvoice_remote",
        "cosyvoice_local",
        "streaming_pcm"
      ],
      "properties": {
        "ipc": {"type": "boolean"},
        "edge_tts": {"type": "boolean"},
        "cosyvoice_remote": {"type": "boolean"},
        "cosyvoice_local": {"const": false},
        "streaming_pcm": {"const": false}
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "required": ["chat_streaming", "chat_cancel", "memory", "knowledge", "rag", "voice"],
      "properties": {
        "chat_streaming": {"type": "boolean"},
        "chat_cancel": {"type": "boolean"},
        "memory": {"type": "boolean"},
        "knowledge": {"type": "boolean"},
        "rag": {"type": "boolean"},
        "voice": {"$ref": "#/$defs/voiceCapabilities"},
        "settings": {"type":"object","additionalProperties":false,"required":["read","update","ui"],
          "properties":{"read":{"const":true},"update":{"const":true},"ui":{"const":false}}}
      },
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "required": [
        "json_frame_max_bytes",
        "chat_input_max_bytes",
        "event_max_bytes",
        "binary_frame_max_bytes"
      ],
      "properties": {
        "json_frame_max_bytes": {"type": "integer", "minimum": 1},
        "chat_input_max_bytes": {"type": "integer", "minimum": 1},
        "event_max_bytes": {"type": "integer", "minimum": 1},
        "binary_frame_max_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "conversationMetadata": {
      "type": "object",
      "required": ["conversation_id", "title", "created_at", "updated_at", "message_count", "model"],
      "properties": {
        "conversation_id": {"$ref": "#/$defs/conversationId"},
        "title": {"type": "string", "maxLength": 4096},
        "created_at": {"type": "string", "maxLength": 4096},
        "updated_at": {"type": "string", "maxLength": 4096},
        "message_count": {"type": "integer", "minimum": 0},
        "model": {"type": "string", "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "conversationMessage": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["system", "user", "assistant"]},
        "content": {"type": "string", "maxLength": 262144}
      },
      "additionalProperties": false
    },
    "conversationDetail": {
      "type": "object",
      "required": ["conversation_id", "title", "created_at", "updated_at", "message_count", "model", "messages"],
      "properties": {
        "conversation_id": {"$ref": "#/$defs/conversationId"},
        "title": {"type": "string", "maxLength": 4096},
        "created_at": {"type": "string", "maxLength": 4096},
        "updated_at": {"type": "string", "maxLength": 4096},
        "message_count": {"type": "integer", "minimum": 0},
        "model": {"type": "string", "maxLength": 4096},
        "messages": {"type": "array", "items": {"$ref": "#/$defs/conversationMessage"}}
      },
      "additionalProperties": false
    },
    "bootstrapReady": {
      "type": "object",
      "required": [
        "protocol",
        "version",
        "type",
        "port",
        "pid",
        "supported_versions",
        "sidecar_instance_id"
      ],
      "properties": {
        "protocol": {"const": "aurora-ipc"},
        "version": {"const": 1},
        "type": {"const": "bootstrap.ready"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "pid": {"type": "integer", "minimum": 1},
        "supported_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "sidecar_instance_id": {"$ref": "#/$defs/opaqueId"}
      },
      "additionalProperties": false
    },
    "hello": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noRequestContext"},
        {
          "required": ["request_id"],
          "properties": {
            "type": {"const": "hello"},
            "payload": {
              "type": "object",
              "required": ["client", "supported_versions"],
              "properties": {
                "client": {"const": "aurora-desktop"},
                "supported_versions": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "integer", "minimum": 1}
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "helloAck": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noRequestContext"},
        {
          "required": ["request_id"],
          "properties": {
            "type": {"const": "hello_ack"},
            "payload": {
              "type": "object",
              "required": [
                "selected_version",
                "sidecar_instance_id",
                "state",
                "capabilities",
                "limits"
              ],
              "properties": {
                "selected_version": {"const": 1},
                "sidecar_instance_id": {"$ref": "#/$defs/opaqueId"},
                "state": {"enum": ["READY", "DEGRADED"]},
                "capabilities": {"$ref": "#/$defs/capabilities"},
                "limits": {"$ref": "#/$defs/limits"}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "healthRequest": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noRequestContext"},
        {
          "required": ["request_id"],
          "properties": {
            "type": {"const": "health.request"},
            "payload": {"type": "object", "maxProperties": 0}
          }
        }
      ]
    },
    "healthResponse": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noRequestContext"},
        {
          "required": ["request_id"],
          "properties": {
            "type": {"const": "health.response"},
            "payload": {
              "type": "object",
              "required": ["state", "sidecar_instance_id", "capabilities", "limits"],
              "properties": {
                "state": {"$ref": "#/$defs/sidecarState"},
                "sidecar_instance_id": {"$ref": "#/$defs/opaqueId"},
                "capabilities": {"$ref": "#/$defs/capabilities"},
                "limits": {"$ref": "#/$defs/limits"},
                "diagnostics": {"$ref": "#/$defs/productionDiagnostics"}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "shutdownRequest": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noRequestContext"},
        {
          "required": ["request_id"],
          "properties": {
            "type": {"const": "shutdown.request"},
            "payload": {"type": "object", "maxProperties": 0}
          }
        }
      ]
    },
    "shutdownAck": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noRequestContext"},
        {
          "required": ["request_id"],
          "properties": {
            "type": {"const": "shutdown.ack"},
            "payload": {
              "type": "object",
              "required": ["accepted"],
              "properties": {"accepted": {"const": true}},
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "chatRequest": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noSequence"},
        {
          "required": ["request_id", "session_id", "generation_id"],
          "properties": {
            "type": {"const": "chat.request"},
            "payload": {
              "type": "object",
              "required": ["conversation_id", "input"],
              "properties": {
                "conversation_id": {
                  "oneOf": [
                    {"$ref": "#/$defs/conversationId"},
                    {"type": "null"}
                  ]
                },
                "input": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "chatAccepted": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noSequence"},
        {
          "required": ["request_id", "session_id", "generation_id"],
          "properties": {
            "type": {"const": "chat.accepted"},
            "payload": {
              "type": "object",
              "required": ["status"],
              "properties": {"status": {"const": "accepted"}, "ipc_received_unix_ms": {"type": "number", "minimum": 0}},
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "chatDelta": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {
          "required": ["request_id", "session_id", "generation_id", "seq"],
          "properties": {
            "type": {"const": "chat.delta"},
            "payload": {
              "type": "object",
              "required": ["delta"],
              "properties": {"delta": {"type": "string", "minLength": 1}, "python_sent_unix_ms": {"type": "number", "minimum": 0}},
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "chatCompleted": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noSequence"},
        {
          "required": ["request_id", "session_id", "generation_id"],
          "properties": {
            "type": {"const": "chat.completed"},
            "payload": {
              "type": "object",
              "required": ["terminal_state"],
              "properties": {
                "terminal_state": {"$ref": "#/$defs/terminalState"},
                "output_chars": {"type": "integer", "minimum": 0},
                "duration_ms": {"type": "number", "minimum": 0},
                "diagnostics": {"$ref": "#/$defs/chatDiagnostics"},
                "error": {"$ref": "#/$defs/errorDetail"}
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "terminal_state": {"enum": ["failed", "backend_lost", "rejected"]}
                    }
                  },
                  "then": {"required": ["error"]},
                  "else": {"not": {"required": ["error"]}}
                }
              ]
            }
          }
        }
      ]
    },
    "chatCancelRequest": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noSequence"},
        {
          "required": ["request_id", "session_id", "generation_id"],
          "properties": {
            "type": {"const": "chat.cancel.request"},
            "payload": {
              "type": "object",
              "required": ["target_request_id"],
              "properties": {
                "target_request_id": {"$ref": "#/$defs/opaqueId"}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "chatCancelAck": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noSequence"},
        {
          "required": ["request_id", "session_id", "generation_id"],
          "properties": {
            "type": {"const": "chat.cancel.ack"},
            "payload": {
              "type": "object",
              "required": ["target_request_id", "outcome"],
              "properties": {
                "target_request_id": {"$ref": "#/$defs/opaqueId"},
                "outcome": {
                  "enum": ["cancel_requested", "cancelled", "already_completed", "not_found"]
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "conversationListRequest": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noRequestContext"},
        {"required": ["request_id"], "properties": {"type": {"const": "conversation.list.request"}, "payload": {"type": "object", "maxProperties": 0}}}
      ]
    },
    "conversationListResponse": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noRequestContext"},
        {"required": ["request_id"], "properties": {"type": {"const": "conversation.list.response"}, "payload": {"type": "object", "required": ["conversations"], "properties": {"conversations": {"type": "array", "items": {"$ref": "#/$defs/conversationMetadata"}}}, "additionalProperties": false}}}
      ]
    },
    "conversationGetRequest": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noRequestContext"},
        {"required": ["request_id"], "properties": {"type": {"const": "conversation.get.request"}, "payload": {"type": "object", "required": ["conversation_id"], "properties": {"conversation_id": {"$ref": "#/$defs/conversationId"}}, "additionalProperties": false}}}
      ]
    },
    "conversationGetResponse": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noRequestContext"},
        {"required": ["request_id"], "properties": {"type": {"const": "conversation.get.response"}, "payload": {"type": "object", "required": ["conversation"], "properties": {"conversation": {"$ref": "#/$defs/conversationDetail"}}, "additionalProperties": false}}}
      ]
    },
    "conversationCreateRequest": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noRequestContext"},
        {"required": ["request_id"], "properties": {"type": {"const": "conversation.create.request"}, "payload": {"type": "object", "maxProperties": 0}}}
      ]
    },
    "conversationChanged": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"not": {"anyOf": [{"required": ["request_id"]}, {"required": ["session_id"]}, {"required": ["generation_id"]}, {"required": ["seq"]}]}},
        {"properties": {"type": {"const": "conversation.changed"}, "payload": {"type": "object", "required": ["conversation"], "properties": {"conversation": {"$ref": "#/$defs/conversationMetadata"}}, "additionalProperties": false}}}
      ]
    },
    "conversationCreateResponse": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noRequestContext"},
        {"required": ["request_id"], "properties": {"type": {"const": "conversation.create.response"}, "payload": {"type": "object", "required": ["conversation"], "properties": {"conversation": {"$ref": "#/$defs/conversationMetadata"}}, "additionalProperties": false}}}
      ]
    },
    "stateChanged": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noIdentifiers"},
        {
          "properties": {
            "type": {"const": "state.changed"},
            "payload": {
              "type": "object",
              "required": ["state"],
              "properties": {
                "state": {"$ref": "#/$defs/sidecarState"},
                "reason": {"type": "string", "maxLength": 512}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "backendWarning": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noSequence"},
        {
          "properties": {
            "type": {"const": "backend.warning"},
            "payload": {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": {"type": "string", "minLength": 1, "maxLength": 64},
                "message": {"type": "string", "minLength": 1, "maxLength": 512}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "error": {
      "allOf": [
        {"$ref": "#/$defs/baseEnvelope"},
        {"$ref": "#/$defs/noSequence"},
        {
          "properties": {
            "type": {"const": "error"},
            "payload": {"$ref": "#/$defs/errorDetail"}
          }
        }
      ]
    }
  }
}
