{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-aurora.invalid/schemas/ipc-v1.schema.json",
  "title": "Project Aurora IPC v1",
  "description": "Bootstrap object and authenticated WebSocket JSON envelopes for Aurora IPC v1.",
  "oneOf": [
    {"$ref": "#/$defs/audioPlay"},
    {"$ref": "#/$defs/audioStop"},
    {"$ref": "#/$defs/audioEvent"},
    {"$ref": "#/$defs/voiceGetRequest"},
    {"$ref": "#/$defs/voiceGetResponse"},
    {"$ref": "#/$defs/voiceStopRequest"},
    {"$ref": "#/$defs/voiceStopResponse"},
    {"$ref": "#/$defs/voiceChanged"},
    {"$ref": "#/$defs/settings_get_request"},
    {"$ref": "#/$defs/settings_get_response"},
    {"$ref": "#/$defs/settings_update_request"},
    {"$ref": "#/$defs/settings_update_response"},
    {"$ref": "#/$defs/settings_changed"},
    {"$ref": "#/$defs/bootstrapReady"},
    {"$ref": "#/$defs/hello"},
    {"$ref": "#/$defs/helloAck"},
    {"$ref": "#/$defs/healthRequest"},
    {"$ref": "#/$defs/healthResponse"},
    {"$ref": "#/$defs/shutdownRequest"},
    {"$ref": "#/$defs/shutdownAck"},
    {"$ref": "#/$defs/chatRequest"},
    {"$ref": "#/$defs/chatAccepted"},
    {"$ref": "#/$defs/chatDelta"},
    {"$ref": "#/$defs/chatCompleted"},
    {"$ref": "#/$defs/chatCancelRequest"},
    {"$ref": "#/$defs/chatCancelAck"},
    {"$ref": "#/$defs/conversationListRequest"},
    {"$ref": "#/$defs/conversationListResponse"},
    {"$ref": "#/$defs/conversationGetRequest"},
    {"$ref": "#/$defs/conversationGetResponse"},
    {"$ref": "#/$defs/conversationCreateRequest"},
    {"$ref": "#/$defs/conversationCreateResponse"},
    {"$ref": "#/$defs/conversationChanged"},
    {"$ref": "#/$defs/stateChanged"},
    {"$ref": "#/$defs/backendWarning"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "audioIdentity": {
      "type":"object", "required":["generation_id","revision"],
      "properties":{"generation_id":{"$ref":"#/$defs/opaqueId"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991}}
    },
    "audioPlay": {"allOf":[
      {"$ref":"#/$defs/baseEnvelope"},{"$ref":"#/$defs/noIdentifiers"},
      {"properties":{"type":{"const":"audio.play.request"},"payload":{"allOf":[
        {"$ref":"#/$defs/audioIdentity"},
        {"type":"object","required":["file"],"properties":{"file":{"type":"string","maxLength":256,"pattern":"^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+\\.(mp3|wav)$"}}}
      ],"unevaluatedProperties":false}}}
    ]},
    "audioStop": {"allOf":[
      {"$ref":"#/$defs/baseEnvelope"},{"$ref":"#/$defs/noIdentifiers"},
      {"properties":{"type":{"const":"audio.stop.request"},"payload":{"allOf":[{"$ref":"#/$defs/audioIdentity"}],"unevaluatedProperties":false}}}
    ]},
    "audioEvent": {"allOf":[
      {"$ref":"#/$defs/baseEnvelope"},{"$ref":"#/$defs/noIdentifiers"},
      {"properties":{"type":{"const":"audio.event"},"payload":{"allOf":[
        {"$ref":"#/$defs/audioIdentity"},
        {"type":"object","required":["state","error_code"],"properties":{
          "state":{"enum":["started","completed","stopped","failed"]},
          "error_code":{"enum":["","INVALID_AUDIO_FILE","AUDIO_FILE_UNAVAILABLE","AUDIO_SIZE_LIMIT","AUDIO_DECODE_FAILED","AUDIO_DEVICE_UNAVAILABLE","AUDIO_DEVICE_FAILED","AUDIO_TIMEOUT","AUDIO_INTERNAL_ERROR","AUDIO_BUSY"]}},
          "if":{"properties":{"state":{"const":"failed"}}},"then":{"properties":{"error_code":{"minLength":1}}},"else":{"properties":{"error_code":{"const":""}}}}
      ],"unevaluatedProperties":false}}}
    ]},
  "voiceSnapshot": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "revision",
      "state",
      "enabled",
      "provider",
      "generation_id",
      "error_code"
    ],
    "properties": {
      "revision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "state": {
        "enum": [
          "idle",
          "preparing",
          "speaking",
          "stopping",
          "error"
        ]
      },
      "enabled": {
        "type": "boolean"
      },
      "provider": {
        "enum": [
          "",
          "edge_tts",
          "remote_cosyvoice",
          "fake"
        ]
      },
      "generation_id": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/$defs/opaqueId"
          }
        ]
      },
      "error_code": {
        "enum": [
          "",
          "VOICE_UNAVAILABLE",
          "SYNTHESIS_FAILED",
          "PLAYBACK_FAILED",
          "VOICE_TIMEOUT",
          "INVALID_VOICE_SETTINGS"
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "state": {
              "const": "error"
            }
          }
        },
        "then": {
          "properties": {
            "error_code": {
              "minLength": 1
            }
          }
        },
        "else": {
          "properties": {
            "error_code": {
              "const": ""
            }
          }
        }
      }
    ]
  },
  "voiceGetRequest": {
    "allOf": [
      {
        "$ref": "#/$defs/baseEnvelope"
      },
      {
        "$ref": "#/$defs/noRequestContext"
      },
      {
        "required": [
          "request_id"
        ],
        "properties": {
          "type": {
            "const": "voice.get.request"
          },
          "payload": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    ]
  },
  "voiceGetResponse": {
    "allOf": [
      {
        "$ref": "#/$defs/baseEnvelope"
      },
      {
        "$ref": "#/$defs/noRequestContext"
      },
      {
        "required": [
          "request_id"
        ],
        "properties": {
          "type": {
            "const": "voice.get.response"
          },
          "payload": {
            "$ref": "#/$defs/voiceSnapshot"
          }
        }
      }
    ]
  },
  "voiceStopRequest": {
    "allOf": [
      {
        "$ref": "#/$defs/baseEnvelope"
      },
      {
        "$ref": "#/$defs/noRequestContext"
      },
      {
        "required": [
          "request_id"
        ],
        "properties": {
          "type": {
            "const": "voice.stop.request"
          },
          "payload": {
            "type": "object",
            "required": [
              "target_generation_id"
            ],
            "properties": {
              "target_generation_id": {
                "$ref": "#/$defs/opaqueId"
              }
            },
            "additionalProperties": false
          }
        }
      }
    ]
  },
  "voiceStopResponse": {
    "allOf": [
      {
        "$ref": "#/$defs/baseEnvelope"
      },
      {
        "$ref": "#/$defs/noRequestContext"
      },
      {
        "required": [
          "request_id"
        ],
        "properties": {
          "type": {
            "const": "voice.stop.response"
          },
          "payload": {
            "$ref": "#/$defs/voiceSnapshot"
          }
        }
      }
    ]
  },
  "voiceChanged": {
    "allOf": [
      {
        "$ref": "#/$defs/baseEnvelope"
      },
      {
        "$ref": "#/$defs/noIdentifiers"
      },
      {
        "properties": {
          "type": {
            "const": "voice.changed"
          },
          "payload": {
            "$ref": "#/$defs/voiceSnapshot"
          }
        }
      }
    ]
  },
  "settings_get_request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "protocol",
      "version",
      "type",
      "payload",
      "request_id"
    ],
    "properties": {
      "protocol": {
        "const": "aurora-ipc"
      },
      "version": {
        "const": 1
      },
      "type": {
        "const": "settings.get.request"
      },
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  },
  "settings_get_response": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "protocol",
      "version",
      "type",
      "payload",
      "request_id"
    ],
    "properties": {
      "protocol": {
        "const": "aurora-ipc"
      },
      "version": {
        "const": 1
      },
      "type": {
        "const": "settings.get.response"
      },
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "status",
          "descriptors"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "enum": [
              "loaded",
              "missing_defaults",
              "invalid_defaults"
            ]
          },
          "descriptors": {
            "type": "array",
            "minItems": 32,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "type",
                "value",
                "default",
                "mutable",
                "restart_required",
                "apply",
                "options",
                "min",
                "max",
                "label_id",
                "value_valid"
              ],
              "properties": {
                "key": {
                  "enum": [
                    "ollama.host",
                    "ollama.thinking_mode",
                    "ollama.keep_alive",
                    "chat_model",
                    "chat_model_mode",
                    "embedding_model",
                    "embedding_model_mode",
                    "resolved_chat_model",
                    "resolved_embedding_model",
                    "memory.max_injection",
                    "memory.min_importance",
                    "memory.retrieval_threshold",
                    "memory.confidence_default",
                    "persona.enabled",
                    "knowledge.enabled",
                    "knowledge.max_results",
                    "rag.pipeline_enabled",
                    "rag.enable_dedup",
                    "rag.enable_ranking",
                    "rag.enable_optimization",
                    "rag.context_budget",
                    "rag.reserved_output",
                    "context.warning_tokens",
                    "voice.enabled",
                    "voice.playback.enabled",
                    "voice.tts.provider",
                    "voice.tts.voice",
                    "voice.tts.timeout_seconds", "live2d.enabled", "live2d.visible", "live2d.x", "live2d.y"
                  ]
                },
                "type": {
                  "enum": [
                    "string",
                    "nullable_string",
                    "integer",
                    "number",
                    "boolean"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ],
                  "maxLength": 512,
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "default": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ],
                  "maxLength": 512,
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "mutable": {
                  "type": "boolean"
                },
                "restart_required": {
                  "type": "boolean"
                },
                "apply": {
                  "enum": [
                    "read_only",
                    "next_request",
                    "restart_required"
                  ]
                },
                "options": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "maxLength": 128
                  }
                },
                "min": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "max": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "label_id": {
                  "type": "string",
                  "maxLength": 160
                },
                "value_valid": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  },
