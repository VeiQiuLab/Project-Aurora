!data/remote/*.example.json

# Personal persona configuration
data/persona/*.json
!data/persona/*.example.json

# Credentials and secrets
data/credential/
data/credentials/
data/private/
.env
*.env

# Logs (may contain personal information)
logs/
*.log
data/logs/
data/log/

# Runtime generated data
data/runtime/
data/cache/
data/temp/
.codex/

# Local user files
*.json.bak
*.backup
*.bak

build/
dist/
*.spec
!Project Aurora.spec
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
tests/output/
.venv/
AGENTS.md

