# =========================
# Personal Data Protection
# =========================

# Chat history
data/conversations/
data/conversations/*

# Personal memory
data/memory/
data/memory/*

# Personal knowledge
data/knowledge/
data/knowledge/*
data/knowledge/private/

# Personal settings
config/settings.json

# Personal remote configuration
data/remote/remote.json
data/remote/*.json
!data/remote/*.example.json

# Personal persona configuration
data/persona/*.json
!data/persona/*.example.json

# Credentials and secrets
data/credential/
data/credentials/
data/private/
.env
*.env

# Logs (may contain personal information)
logs/
*.log
data/logs/
data/log/

# Runtime generated data
data/runtime/
data/cache/
data/temp/
.codex/

# Local user files
*.json.bak
*.backup
*.bak

build/
dist/
*.spec
__pycache__/
**/__pycache__/
*.pyc
